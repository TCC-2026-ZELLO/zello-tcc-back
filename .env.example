# ==============================================================================
# ZELLO BACKEND - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente
# ==============================================================================

# --- Servidor HTTP ---
PORT=3001
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4000,http://localhost:3001

# --- Banco de Dados PostgreSQL + PostGIS ---
# Quando executado localmente apontando para o container db-tcc (porta exposta 5433):
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=zello_db

# --- Autenticação JWT ---
JWT_SECRET=substitua_por_uma_chave_secreta_forte_com_pelo_menos_32_caracteres

# --- Autenticação Social (Google OAuth 2.0) ---
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_google
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:5173/explore

# --- Serviço de E-mail (SMTP / Nodemailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=notificacoes@zello.com.br
MAIL_PASS=sua_senha_de_app_smtp
MAIL_SECURE=false
MAIL_FROM="Zello Agendamentos <noreply@zello.com.br>"

# --- Armazenamento de Arquivos (Azure Blob Storage - Opcional) ---
# Se omitidos, os uploads serão salvos localmente na pasta ./uploads
AZURE_SAS_URL=
AZURE_SAS_TOKEN=

# --- Integrações Externas ---
# Habilita consulta automática de CNPJ na ReceitaWS ('true' ou 'false')
CNPJ_LOOKUP_ENABLED=true
