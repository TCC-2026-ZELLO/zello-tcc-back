# ==============================================================================
# ZELLO BACKEND - VARIÁVEIS DE AMBIENTE (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente
# ==============================================================================

# --- Servidor HTTP ---
PORT=3001
NODE_ENV=development
FRONTEND_BASE_URL=http://localhost:5173
# Allowlist exata de origens (sem curinga). Em produção só valem origens https://.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Proxies confiáveis à frente da API (ingress do Azure / nginx). 0 em desenvolvimento.
TRUST_PROXY_HOPS=0
# SameSite dos cookies de sessão: strict (padrão em produção) | lax | none
# COOKIE_SAMESITE=strict

# --- Banco de Dados PostgreSQL + PostGIS ---
# Quando executado localmente apontando para o container db-tcc (porta exposta 5433):
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=zello_db
# TLS com o banco. Em produção o certificado é sempre validado.
DB_SSL=false
# DB_SSL_CA=
# Em desenvolvimento o schema é sincronizado pelas entidades; em produção só
# por migrations (DB_SYNCHRONIZE=true é recusado com NODE_ENV=production).
DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=false

# --- Integração WhatsApp (componente de risco, desligado por padrão) ---
WHATSAPP_ENABLED=false
# WHATSAPP_CHROMIUM_NO_SANDBOX=false

# --- Autenticação JWT ---
# Segredo HS256 com no mínimo 32 bytes aleatórios. Em produção vem do cofre de
# segredos do Azure Container Apps, nunca deste arquivo. Para gerar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Sessão (valores em minutos/horas; padrões da especificação de segurança) ---
ACCESS_TOKEN_TTL_MINUTES=15
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=168
PASSWORD_RESET_TTL_MINUTES=10

# --- Rate limiting ---
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_ACCOUNT=10

# --- Primeiro administrador (opcional) ---
# E-mail de uma conta já cadastrada que recebe o papel admin na inicialização.
# Não existe conta administrativa padrão nem senha de fábrica.
BOOTSTRAP_ADMIN_EMAIL=

# --- Autenticação Social (Google OAuth 2.0) ---
GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret_google
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
GOOGLE_REDIRECT_URL=http://localhost:5173/explore

# --- Serviço de E-mail (SMTP / Nodemailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=notificacoes@zello.com.br
MAIL_PASS=sua_senha_de_app_smtp
MAIL_SECURE=false
MAIL_FROM="Zello Agendamentos <noreply@zello.com.br>"

# --- Armazenamento de Arquivos (Azure Blob Storage - Opcional) ---
# Se omitidos, os uploads serão salvos localmente na pasta ./uploads
AZURE_SAS_URL=
AZURE_SAS_TOKEN=

# --- Integrações Externas ---
# Habilita consulta automática de CNPJ na ReceitaWS ('true' ou 'false')
CNPJ_LOOKUP_ENABLED=true
